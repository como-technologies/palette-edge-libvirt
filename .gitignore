# The lab writes every file that you want to keep outside the checkout, and it
# writes nothing into this one. See `just config` for the directories. The names
# below stay because a wrong PEL_ override would put a registration token here.
envs/
*.local

# Generated per-host cloud-init seeds (contain the registration token)
build/
seeds/

# Downloaded host image
images/
*.iso
*.img

# OpenTofu state and provider files. `just cluster-up` puts both in
# ~/.local/state/palette-edge-libvirt/<project>/, so neither belongs here. The
# names below stay because a wrong PEL_ override would put a state file in the
# checkout, and a state file holds the kubeconfig of the cluster.
# terraform/.terraform.lock.hcl is committed on purpose: it pins the provider.
*.tfstate
*.tfstate.*
.terraform/
*.tfplan

# mdBook output
docs/book/

# mdbook-mermaid / mdbook-gruvbox installed assets are committed on purpose;
# only strip editor and OS noise below.
*.swp
*~
.DS_Store
