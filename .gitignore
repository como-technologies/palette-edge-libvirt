# The lab keeps every file that you want to keep outside the checkout. See
# `just config` for the directories. The names below cover the link that the
# justfile reads, and the old layout that `just adopt-xdg` moves out.
.env
.env.bak*
envs/
*.local

# Generated per-host cloud-init seeds (contain the registration token)
build/
seeds/

# Downloaded host image
images/
*.iso
*.img

# mdBook output
docs/book/

# mdbook-mermaid / mdbook-gruvbox installed assets are committed on purpose;
# only strip editor and OS noise below.
*.swp
*~
.DS_Store
