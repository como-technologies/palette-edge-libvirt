# The lab writes every file that you want to keep outside the checkout, and it
# writes nothing into this one. See `just config` for the directories. The names
# below stay because a wrong PEL_ override would put a registration token here.
envs/
*.local

# Generated per-host cloud-init seeds (contain the registration token)
build/
seeds/

# Downloaded host image
images/
*.iso
*.img

# mdBook output
docs/book/

# mdbook-mermaid / mdbook-gruvbox installed assets are committed on purpose;
# only strip editor and OS noise below.
*.swp
*~
.DS_Store
