<!--
  The isolated NAT network of the cluster.

  scripts/net-up.sh replaces @NAME@ with CLUSTER_NAME-net, @BRIDGE@ with
  br-CLUSTER_NAME, and @SUBNET@ with CLUSTER_SUBNET. Then it defines the network.

  The bridge name is a Linux interface name, so it takes 15 characters at most.
  "br-" leaves 12 characters for CLUSTER_NAME, and project-new.sh keeps to that.
  A longer name gives "error creating bridge interface ...: Numerical result
  out of range" when the network starts.

  The DHCP range starts at .50. The addresses .10 to .49 stay free. Use them for
  a fixed address, for example a registry mirror or a control plane VIP.
-->
<!-- ANCHOR: network -->
<network>
  <name>@NAME@</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='@BRIDGE@' stp='on' delay='0'/>
  <domain name='@NAME@.cluster' localOnly='yes'/>
  <ip address='@SUBNET@.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='@SUBNET@.50' end='@SUBNET@.199'/>
    </dhcp>
  </ip>
</network>
<!-- ANCHOR_END: network -->
