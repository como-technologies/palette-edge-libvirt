<!--
  The isolated NAT network of the lab.

  scripts/net-up.sh replaces @NAME@ with LAB_NAME-net and @SUBNET@ with
  LAB_SUBNET. Then it defines the network.

  The DHCP range starts at .50. The addresses .10 to .49 stay free. Use them for
  a fixed address, for example a registry mirror or a control plane VIP.
-->
<!-- ANCHOR: network -->
<network>
  <name>@NAME@</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr-@NAME@' stp='on' delay='0'/>
  <domain name='@NAME@.lab' localOnly='yes'/>
  <ip address='@SUBNET@.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='@SUBNET@.50' end='@SUBNET@.199'/>
    </dhcp>
  </ip>
</network>
<!-- ANCHOR_END: network -->
