# The template for a project environment file.
#
# `just new-project <name>` copies this file to
# ~/.config/palette-edge-libvirt/envs/<name>.env and fills in the values that it
# knows. Nothing copies this file by hand, and the checkout holds no environment
# file of its own.
#
# Delete the checkout and your projects, your tokens, and your settings stay.
# To see the directories: just config
#
# Each value is also a normal environment variable. To change one value for one
# command, set it on the command line:
#
#   WORKER_COUNT=3 just cluster-up
#
# To see the effective values, run: just config

# ANCHOR: dirs
# --- Directories ------------------------------------------------------------
#
# These variables move the tooling directories. Set them in your shell, not in
# this file: a project file lives in PEL_CONFIG_DIR, so the tooling must find
# that directory before it reads any project file.
#
#   PEL_CONFIG_DIR   the projects        default ~/.config/palette-edge-libvirt
#   PEL_DATA_DIR     seeds and build     default ~/.local/share/palette-edge-libvirt
#   PEL_STATE_DIR    the OpenTofu state  default ~/.local/state/palette-edge-libvirt
#   PEL_CACHE_DIR    the cloud image     default ~/.cache/palette-edge-libvirt
#   PEL_BIN_DIR      OpenTofu            default ~/.local/bin
#
# The API key ignores PEL_CONFIG_DIR. It always uses the XDG configuration
# directory, because a key must never go into a checkout.
# ANCHOR_END: dirs

# ANCHOR: palette
# --- Palette (SaaS) tenant --------------------------------------------------

# The Palette API endpoint. SaaS tenants use api.spectrocloud.com. A dedicated
# instance uses a different name. Use the name in the URL that you log in to.
PALETTE_ENDPOINT=api.spectrocloud.com

# The project that the hosts register into. There is no default. A tenant need
# not have a project called "Default", and a tenant can delete that one.
#
# The name is case sensitive and must match the project in Palette exactly. A
# wrong name gives no error. The host installs correctly and never shows in the
# console.
#
# `just new-project` writes this value. To see the names: just palette-projects
PALETTE_PROJECT=

# The host registration token. `just new-project` makes one for the project
# and writes it here, so you do not copy it by hand.
# This token goes into each seed ISO. Git ignores the seeds/ directory.
PALETTE_EDGE_TOKEN=

# The lifetime of a token that `just new-project` makes, in days.
PALETTE_TOKEN_DAYS=90

# The Palette API key is NOT in this file. A key carries every permission of
# the user that owns it, so it is a tenant credential and not a project one.
# It lives in one file outside the checkout, and no project recipe touches it:
#
#   just api-key-set        store it
#   just api-key-status     report its length
#   just api-key-clear      delete it
# ANCHOR_END: palette

# ANCHOR: agent
# --- Palette agent ----------------------------------------------------------

# kube-vip gives a virtual address to the control plane, and Palette refuses a
# cluster that gives no control plane endpoint. Keep this value false, so
# kube-vip answers at CLUSTER_VIP below.
#
# Set it to true only for a host that joins no cluster. A host that skipped
# kube-vip registers correctly, and the cluster then fails much later.
PALETTE_VIP_SKIP=false

# The version of the agent install script. Keep this value empty for the
# latest release.
PALETTE_AGENT_VERSION=
# ANCHOR_END: agent

# ANCHOR: image
# --- Host image -------------------------------------------------------------

# The Ubuntu release. The tooling uses the stock Ubuntu cloud image. It does not
# build a custom image.
UBUNTU_RELEASE=noble

# The full image URL. Keep this value empty to build the URL from
# UBUNTU_RELEASE.
UBUNTU_IMAGE_URL=

# The password of the local "ubuntu" user on the serial console.
# The cluster uses an isolated NAT network. Change this value for any other use.
HOST_PASSWORD=ubuntu
# ANCHOR_END: image

# ANCHOR: topology
# --- Cluster topology -----------------------------------------------------------

# The prefix for each libvirt object that this repository creates. Change the
# prefix to run a second cluster at the same time.
CLUSTER_NAME=pe

# The Palette agent needs 2 CPU, 8 GB of memory, and 100 GB of storage for each
# host. These values give that minimum or more.
CONTROL_COUNT=1
CONTROL_VCPUS=4
CONTROL_MEMORY_MB=8192
CONTROL_DISK_GB=100

WORKER_COUNT=2
WORKER_VCPUS=6
WORKER_MEMORY_MB=16384
WORKER_DISK_GB=100
# ANCHOR_END: topology

# ANCHOR: clusterlayer
# --- Cluster layer ----------------------------------------------------------
#
# The cluster profile and the cluster. OpenTofu makes both, and each pack
# version is pinned. A pinned version is what makes a test repeatable.
#
# To see the versions that a pack offers now:  just palette-packs edge-k8s

# The version of OpenTofu that `just tofu-install` puts in ~/.local/bin.
TOFU_VERSION=1.12.6

# The operating system layer: the BYOOS (Edge) pack, Agent Mode preset. See
# terraform/values/edge-native-byoi.yaml.
OS_PACK_VERSION=2.1.0

# The Kubernetes layer: Palette eXtended Kubernetes - Edge (PXK-E).
K8S_VERSION=1.33.13

# The network layer: Calico. Palette lists Ubuntu with PXK-E and Calico as a
# verified combination.
CNI_VERSION=3.32.1

# The storage layer: the local path provisioner. It needs no hardware, and it
# gives the cluster one storage class.
CSI_VERSION=0.0.37

# The virtual address of the control plane. Palette needs one for a cluster of
# one control plane node as well as for a cluster of three.
#
# Use a free address of the cluster subnet, below the DHCP pool. `just
# new-project` writes the .10 address of the subnet that it allocated. See the
# address plan in docs/src/network.md.
CLUSTER_VIP=192.168.140.10

# The address range of the pods.
#
# The pack default is 192.168.0.0/16, and that range holds every cluster subnet
# and most home and office networks. Calico gives no NAT to a destination inside
# its own pool, so the pods then cannot reach the gateway of the cluster
# network, and the cluster waits for a name that it cannot resolve.
#
# Keep a range that holds neither CLUSTER_SUBNET nor the address of your
# workstation.
POD_CIDR=10.244.0.0/16
# ANCHOR_END: clusterlayer

# ANCHOR: libvirt
# --- libvirt ----------------------------------------------------------------

LIBVIRT_DEFAULT_URI=qemu:///system

# The subnet of the cluster NAT network. Use a subnet that no other libvirt network
# uses. The default libvirt network usually uses 192.168.122.0/24.
CLUSTER_SUBNET=192.168.140
# ANCHOR_END: libvirt
