# Copy this file to .env and add the values from your Palette tenant.
# Git ignores .env.
#
#   cp .env.example .env
#
# Each value is also a normal environment variable. To change one value for one
# command, set it on the command line:
#
#   WORKER_COUNT=3 just cluster-up
#
# To see the effective values, run: just config

# ANCHOR: palette
# --- Palette (SaaS) tenant --------------------------------------------------

# The Palette API endpoint. SaaS tenants use api.spectrocloud.com. A dedicated
# instance uses a different name. Use the name in the URL that you log in to.
PALETTE_ENDPOINT=api.spectrocloud.com

# The project that the Edge Hosts register into.
# Palette shows the project in the selector at the top of the page.
PALETTE_PROJECT=Default

# The Edge Host registration token.
# Palette > Tenant Settings > Registration Tokens.
# This token goes into each seed ISO. Git ignores the seeds/ directory.
PALETTE_EDGE_TOKEN=

# The Palette API key. You need this key only if you call the Palette API.
# Palette > User Menu > My API Keys.
PALETTE_API_KEY=
# ANCHOR_END: palette

# ANCHOR: installer
# --- Edge installer media ---------------------------------------------------

# The version of the Palette Edge installer ISO to download.
EDGE_INSTALLER_VERSION=v4.7.6

# The full download URL. Keep this value empty to build the URL from
# EDGE_INSTALLER_VERSION. Set it to use the ISO link from your own tenant.
EDGE_INSTALLER_URL=
# ANCHOR_END: installer

# ANCHOR: topology
# --- Lab topology -----------------------------------------------------------

# The prefix for each libvirt object that this repository creates. Change the
# prefix to run a second lab at the same time.
LAB_NAME=pe

CONTROL_COUNT=1
CONTROL_VCPUS=4
CONTROL_MEMORY_MB=8192
CONTROL_DISK_GB=60

WORKER_COUNT=2
WORKER_VCPUS=6
WORKER_MEMORY_MB=16384
WORKER_DISK_GB=100
# ANCHOR_END: topology

# ANCHOR: libvirt
# --- libvirt ----------------------------------------------------------------

LIBVIRT_DEFAULT_URI=qemu:///system

# The subnet of the lab NAT network. Use a subnet that no other libvirt network
# uses. The default libvirt network usually uses 192.168.122.0/24.
LAB_SUBNET=192.168.140
# ANCHOR_END: libvirt
