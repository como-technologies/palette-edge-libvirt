# Copy this file to .env and add the values from your Palette tenant.
# Git ignores .env.
#
#   cp .env.example .env
#
# Each value is also a normal environment variable. To change one value for one
# command, set it on the command line:
#
#   WORKER_COUNT=3 just cluster-up
#
# To see the effective values, run: just config

# ANCHOR: palette
# --- Palette (SaaS) tenant --------------------------------------------------

# The Palette API endpoint. SaaS tenants use api.spectrocloud.com. A dedicated
# instance uses a different name. Use the name in the URL that you log in to.
PALETTE_ENDPOINT=api.spectrocloud.com

# The project that the hosts register into. The name is case sensitive and must
# match the project in Palette exactly. A wrong name gives no error. The host
# installs correctly and never shows in the console.
#
# To list your projects, run: just palette-projects
PALETTE_PROJECT=Default

# The host registration token. `just new-project` makes one for the project
# and writes it here, so you do not copy it by hand.
# This token goes into each seed ISO. Git ignores the seeds/ directory.
PALETTE_EDGE_TOKEN=

# The lifetime of a token that `just new-project` makes, in days.
PALETTE_TOKEN_DAYS=90

# The Palette API key. Palette > User Menu > My API Keys.
# `just palette-projects` and `just palette-hosts` use this key.
PALETTE_API_KEY=
# ANCHOR_END: palette

# ANCHOR: agent
# --- Palette agent ----------------------------------------------------------

# kube-vip gives a virtual address to the control plane. A lab with one control
# plane node does not need it. Set this value to false if you make a cluster
# with more than one control plane node. Then give the VIP in Palette. Use an
# address from the free range of the lab subnet, for example 192.168.140.10.
PALETTE_VIP_SKIP=true

# The version of the agent install script. Keep this value empty for the
# latest release.
PALETTE_AGENT_VERSION=
# ANCHOR_END: agent

# ANCHOR: image
# --- Host image -------------------------------------------------------------

# The Ubuntu release. The lab uses the stock Ubuntu cloud image. It does not
# build a custom image.
UBUNTU_RELEASE=noble

# The full image URL. Keep this value empty to build the URL from
# UBUNTU_RELEASE.
UBUNTU_IMAGE_URL=

# The password of the local "ubuntu" user on the serial console.
# The lab uses an isolated NAT network. Change this value for any other use.
HOST_PASSWORD=ubuntu
# ANCHOR_END: image

# ANCHOR: topology
# --- Lab topology -----------------------------------------------------------

# The prefix for each libvirt object that this repository creates. Change the
# prefix to run a second lab at the same time.
LAB_NAME=pe

# The Palette agent needs 2 CPU, 8 GB of memory, and 100 GB of storage for each
# host. These values give that minimum or more.
CONTROL_COUNT=1
CONTROL_VCPUS=4
CONTROL_MEMORY_MB=8192
CONTROL_DISK_GB=100

WORKER_COUNT=2
WORKER_VCPUS=6
WORKER_MEMORY_MB=16384
WORKER_DISK_GB=100
# ANCHOR_END: topology

# ANCHOR: libvirt
# --- libvirt ----------------------------------------------------------------

LIBVIRT_DEFAULT_URI=qemu:///system

# The subnet of the lab NAT network. Use a subnet that no other libvirt network
# uses. The default libvirt network usually uses 192.168.122.0/24.
LAB_SUBNET=192.168.140
# ANCHOR_END: libvirt
